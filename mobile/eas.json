{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://REPLACE-with-your-otao-domain",
        "EXPO_PUBLIC_BUNDLE_ID": "app.otao.ios",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "",
        "EXPO_PUBLIC_MICROSOFT_CLIENT_ID": ""
      }
    },
    "development": { "extends": "base", "developmentClient": true, "distribution": "internal" },
    "preview": { "extends": "base", "distribution": "internal" },
    "production": { "extends": "base", "autoIncrement": true }
  },
  "submit": {
    "production": { "ios": {} }
  }
}
