# Postgres connection string (Vercel > Storage > Neon adds this automatically)
DATABASE_URL=

# Vercel Blob token for meal photos (Vercel > Storage > Blob adds this automatically)
BLOB_READ_WRITE_TOKEN=

# Model used for nutrition estimates, as a Vercel AI Gateway model id ("provider/model").
AI_MODEL=
# Only needed locally; on Vercel the AI Gateway authenticates automatically.
AI_GATEWAY_API_KEY=

# Time zone used for "today" in the meal plan, e.g. Europe/Zurich
APP_TIMEZONE=UTC

# Optional: protect the whole site with a password (asked once per device)
APP_PASSWORD=

# Optional: API key for adding meals from other tools (Help page → Add meals automatically)
API_KEY=

# Phone app sign-in (see mobile/README.md). Each provider is off until its id is set.
# iOS bundle id(s), the audience of Sign in with Apple tokens
APPLE_BUNDLE_IDS=
# Google OAuth client id(s) of the app, comma-separated
GOOGLE_CLIENT_IDS=
# Microsoft Entra app registration (client) id
MICROSOFT_CLIENT_ID=
# Household members who may sign in without an invite: email=Name, comma-separated
APP_ALLOWED_EMAILS=
# Optional: a long code App Review uses to sign in (leave empty to turn it off)
APP_REVIEW_CODE=
