# Postgres connection string (Vercel > Storage > Neon adds this automatically)
DATABASE_URL=

# Vercel Blob token for meal photos (Vercel > Storage > Blob adds this automatically)
BLOB_READ_WRITE_TOKEN=

# Model used for nutrition estimates, as a Vercel AI Gateway model id ("provider/model").
AI_MODEL=
# Only needed locally; on Vercel the AI Gateway authenticates automatically.
AI_GATEWAY_API_KEY=

# Time zone used for "today" in the meal plan, e.g. Europe/Zurich
APP_TIMEZONE=UTC

# Optional: protect the whole site with a password (asked once per device)
APP_PASSWORD=

# Optional: API key for adding meals from other tools (Help page → Add meals automatically)
API_KEY=
